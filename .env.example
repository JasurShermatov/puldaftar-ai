# =====================================================================
#  Hisobchi AI — sozlamalar.
#  Eng oson yo'l:  ./scripts/setup.sh  (hammasini o'zi to'ldiradi va ishga tushiradi)
#  DIQQAT: qiymatdan keyin shu qatorda izoh yozmang. .env ni git'ga qo'shmang.
# =====================================================================

# ---------- Umumiy ----------
# production | development (development da /api/docs ochiq)
APP_ENV=production
# Domen yo'q bo'lsa: <IP nuqtalari chiziqcha bilan>.sslip.io, masalan 203-0-113-10.sslip.io
# (setup.sh server IP sini aniqlab, avtomatik qo'yadi; HTTPS sertifikatni certbot oladi: ./scripts/ssl.sh)
DOMAIN=
PUBLIC_BASE_URL=
# Let's Encrypt ogohlantirishlari uchun (ixtiyoriy)
LETSENCRYPT_EMAIL=
LOG_LEVEL=INFO

# ---------- Telegram ----------
# @BotFather dan
BOT_TOKEN=
# polling — domen/webhook talab qilmaydi (tavsiya). webhook — ko'p serverli holat uchun
BOT_MODE=polling
WEBHOOK_SECRET=
# Superadminlar: Telegram ID lar, vergul bilan (@userinfobot dan bilasiz). Nechta ID — shuncha superadmin.
# Ro'yxatdan olib tashlangan ID keyingi kirishda oddiy userga aylanadi. O'zgartirgach: docker compose up -d
SUPERADMIN_IDS=

# ---------- PostgreSQL ----------
POSTGRES_DB=hisobchi
POSTGRES_USER=hisobchi_owner
POSTGRES_PASSWORD=
DB_APP_ROLE=hisobchi_app
DB_APP_PASSWORD=
DB_HOST=db
DB_PORT=5432
# Ixtiyoriy; bo'sh bo'lsa yuqoridagilardan yig'iladi
DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_POOL_MIN=2
DB_POOL_MAX=20

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Xavfsizlik ----------
# 32 bayt base64. YO'QOTMANG: usiz shifrlangan izohlarni ochib bo'lmaydi — zaxiralab qo'ying!
DATA_ENCRYPTION_KEY=
HASH_SECRET=
INIT_DATA_MAX_AGE_SEC=86400

# ---------- OpenAI ----------
# sk-... (bo'sh bo'lsa: matn lokal parser bilan ishlaydi, ovoz o'chiq)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_PARSER_MODEL=gpt-4o-mini
OPENAI_INSIGHT_MODEL=gpt-4o-mini
# gpt-4o-transcribe yoki whisper-1
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TIMEOUT_SEC=25

# ---------- Limitlar ----------
RATE_LIMIT_PER_MINUTE=30
MAX_TEXT_LEN=1000
MAX_VOICE_SECONDS=120
